{
  "name": "santra",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://example.invalid/santra",
  "desktopName": "santra.desktop",
  "description": "A little orange. A lot of possibilities. Private local file conversion for Windows and Linux.",
  "author": "Santra contributors",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "tauri dev",
    "tauri:dev": "tauri dev",
    "tauri:build": "node scripts/build-windows-hook.mjs && tauri build",
    "tauri:dist:linux": "tauri build --bundles deb,appimage",
    "tauri:dist:windows": "node scripts/build-windows-hook.mjs && tauri build --bundles nsis",
    "build:windows-hook": "node scripts/build-windows-hook.mjs",
    "build:windows-hook:cross": "node scripts/build-windows-hook.mjs --cross",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "cargo test --manifest-path src-tauri/Cargo.toml --locked && node --test native/windows/protocol.test.mjs",
    "test:e2e": "playwright test",
    "dist": "npm run tauri:build",
    "dist:windows": "npm run tauri:dist:windows",
    "dist:linux": "npm run tauri:dist:linux",
    "check:release": "node scripts/check-release.mjs",
    "release:report": "node scripts/release-report.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test:website": "playwright test --config website/playwright.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  }
}
