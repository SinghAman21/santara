{
  "name": "santara",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://example.invalid/santara",
  "desktopName": "santara.desktop",
  "description": "A little orange. A lot of possibilities. Private local file conversion for Windows and Linux.",
  "author": "Santara contributors",
  "license": "MIT",
  "main": "electron/main.mjs",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "desktop": "npm run build:windows-hook && node scripts/desktop.mjs",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:dist:linux": "tauri build --bundles deb,appimage",
    "tauri:dist:windows": "node scripts/build-windows-hook.mjs && tauri build --bundles nsis",
    "build:windows-hook": "node scripts/build-windows-hook.mjs",
    "build:windows-hook:cross": "node scripts/build-windows-hook.mjs --cross",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "test:desktop": "node tests/electron-smoke.mjs",
    "manifest": "node scripts/export-capabilities.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "dist": "node scripts/package.mjs",
    "dist:windows": "node scripts/package.mjs --win --x64 --publish never",
    "dist:linux": "node scripts/package.mjs --linux --x64 --publish never",
    "licenses": "node scripts/collect-licenses.mjs",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "tar-stream": "^3.1.7",
    "yauzl": "^3.2.0",
    "yazl": "^3.3.1"
  },
  "overrides": {
    "@electron/get": {
      "global-agent": "^4.1.3"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.4",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^44.9.0",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^6.1.0",
    "wait-on": "^8.0.2"
  }
}
